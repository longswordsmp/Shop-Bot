# Copy to .env for local development. Never commit .env.
# In production, set these as Railway service variables instead.

# Bot token from the Discord Developer Portal (Bot tab). Required.
DISCORD_TOKEN=replace-with-your-bot-token

# Numeric ID of the Discord server the bot manages. Required.
GUILD_ID=000000000000000000

# Numeric ID of the bot owner's Discord account (always treated as admin). Optional.
OWNER_ID=000000000000000000

# SQLite database path. On Railway use the persistent volume: /data/bot.db
DB_PATH=./data/bot.db

# Directory containing settings.toml and content.toml. Optional (default: ./config)
CONFIG_DIR=./config

# Logging: DEBUG, INFO, WARNING, ERROR. Optional (default: INFO)
LOG_LEVEL=INFO
# Log format: json (production) or text (local). Optional (default: json)
LOG_FORMAT=text

# development or production. Optional (default: production)
APP_ENV=development
